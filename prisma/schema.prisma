generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VISITOR
  SELLER
  DEALER
  ADMIN
}

enum SellerType {
  PRIVATE
  DEALER
}

enum ListingStatus {
  ACTIVE
  PENDING
  SOLD
  REMOVED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  PLUG_IN_HYBRID
}

enum Transmission {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
}

enum BodyType {
  SEDAN
  HATCHBACK
  SUV
  COUPE
  CONVERTIBLE
  WAGON
  VAN
  PICKUP
}

enum VehicleCondition {
  NEW
  USED
  CERTIFIED
}

model User {
  id             String           @id @default(cuid())
  name           String?
  email          String?          @unique
  emailVerified  DateTime?
  image          String?
  role           Role             @default(VISITOR)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sellerProfile  SellerProfile?
  dealerProfile  DealerProfile?
  listings       CarListing[]     @relation("UserListings")
  favorites      Favorite[]
  inquiryThreads InquiryThread[]
  inquiryMessages InquiryMessage[]
  reports        Report[]
  verification   VerificationRequest?
  accounts       Account[]
  sessions       Session[]
}

model SellerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  phone       String?
  location    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model DealerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  name          String
  slug          String   @unique
  description   String
  phone         String?
  address       String
  website       String?
  hours         String
  isVerified    Boolean  @default(false)
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  listings      CarListing[]
  verification  VerificationRequest?
}

model CarListing {
  id               String           @id @default(cuid())
  title            String
  make             String
  model            String
  year             Int
  trim             String?
  mileage          Int
  fuel             FuelType
  transmission     Transmission
  engine           String
  bodyType         BodyType
  price            Int
  location         String
  latitude         Float?
  longitude        Float?
  condition        VehicleCondition
  vin              String?
  serviceHistory   Boolean          @default(false)
  nctExpiry        DateTime?
  description      String
  status           ListingStatus    @default(PENDING)
  sellerType       SellerType
  sellerUserId     String
  dealerProfileId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  seller           User             @relation("UserListings", fields: [sellerUserId], references: [id])
  dealerProfile    DealerProfile?   @relation(fields: [dealerProfileId], references: [id])
  photos           Photo[]
  inquiryThreads   InquiryThread[]
  favorites        Favorite[]
  reports          Report[]

  @@index([make, model])
  @@index([price])
  @@index([year])
  @@index([mileage])
}

model Photo {
  id          String      @id @default(cuid())
  listingId   String
  url         String
  alt         String
  isPrimary   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  listing     CarListing  @relation(fields: [listingId], references: [id])
}

model InquiryThread {
  id          String           @id @default(cuid())
  listingId   String
  buyerId     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  listing     CarListing       @relation(fields: [listingId], references: [id])
  buyer       User             @relation(fields: [buyerId], references: [id])
  messages    InquiryMessage[]

  @@unique([listingId, buyerId])
}

model InquiryMessage {
  id          String         @id @default(cuid())
  threadId    String
  senderId    String
  content     String
  createdAt   DateTime       @default(now())
  thread      InquiryThread  @relation(fields: [threadId], references: [id])
  sender      User           @relation(fields: [senderId], references: [id])
}

model Favorite {
  id         String      @id @default(cuid())
  userId     String
  listingId  String
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
  listing    CarListing  @relation(fields: [listingId], references: [id])

  @@unique([userId, listingId])
}

model Report {
  id         String      @id @default(cuid())
  userId     String
  listingId  String
  reason     String
  details    String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
  listing    CarListing  @relation(fields: [listingId], references: [id])
}

model VerificationRequest {
  id             String   @id @default(cuid())
  dealerProfileId String? @unique
  userId         String?  @unique
  status         String   @default("PENDING")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  dealerProfile  DealerProfile? @relation(fields: [dealerProfileId], references: [id])
  user           User?    @relation(fields: [userId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
